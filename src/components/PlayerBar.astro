<!-- ══════════ PLAYER BAR ══════════ -->
<footer class="player">
  <div class="pb-track">
    <button class="pb-art" id="pbArt" data-i18n-aria="nowPlaying" aria-label="يُتلى الآن"><img id="pbArtImg" alt=""><span class="ov-ic"><svg class="ic" viewBox="0 0 24 24"><path d="M4 9V4h5"/><path d="M20 15v5h-5"/><path d="M4 4l6 6"/><path d="M20 20l-6-6"/></svg></span></button>
    <div class="pb-info"><div class="pb-title" id="pbTitle" dir="auto">أُنس</div><div class="pb-sub" id="pbSub" dir="auto" data-i18n="tagline">رفيقك لتلاوة القرآن الكريم</div></div>
    <button class="ctrl pb-fav" id="pbFav" data-i18n-aria="favorite" aria-label="المفضلة"><svg class="ic" viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.3-9A5.2 5.2 0 0 1 12 6.6a5.2 5.2 0 0 1 9.3 4.9c-1.8 4.4-9.3 9-9.3 9z"/></svg></button>
  </div>
  <div class="pb-center">
    <div class="pb-buttons">
      <button class="ctrl" id="btnShuffle" data-i18n-aria="shuffle" aria-label="عشوائي"><svg class="ic" viewBox="0 0 24 24"><path d="M16 4h4v4"/><path d="M4 20 20 4"/><path d="M16 20h4v-4"/><path d="m14.5 14.5 5.5 5.5"/><path d="m4 4 5 5"/></svg></button>
      <button class="ctrl" id="btnPrev" data-i18n-aria="previous" aria-label="السابق"><svg class="ic fill" viewBox="0 0 24 24"><path d="M18 5v14l-9-7z"/><rect x="5" y="5" width="2.6" height="14" rx="1"/></svg></button>
      <button class="play-btn" id="btnPlay" data-i18n-aria="play" aria-label="تشغيل"><svg class="ic play-ic" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z"/></svg></button>
      <button class="ctrl" id="btnNext" data-i18n-aria="next" aria-label="التالي"><svg class="ic fill" viewBox="0 0 24 24"><path d="M6 5v14l9-7z"/><rect x="16.4" y="5" width="2.6" height="14" rx="1"/></svg></button>
      <button class="ctrl" id="btnRepeat" data-i18n-aria="repeat" aria-label="تكرار"><svg class="ic" viewBox="0 0 24 24"><path d="M17 2.5 21 6l-4 3.5"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="M7 21.5 3 18l4-3.5"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></svg><span class="rep-1" id="repBadge" hidden>1</span></button>
    </div>
    <div class="pb-progress">
      <span class="t" id="tCur">0:00</span>
      <div class="prog" id="progBar" role="slider" tabindex="0" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" data-i18n-aria="kSeek" aria-label="تقدّم / إيقاع ٥ ثوانٍ"><div class="rail"><div class="buf" id="progBuf"></div><div class="fill" id="progFill"></div><div class="thumb" id="progThumb"></div></div></div>
      <span class="t" id="tDur">0:00</span>
    </div>
  </div>
  <div class="pb-right">
    <button class="ctrl" id="npPin" data-i18n-title="pin" data-i18n-aria="pin" aria-label="تثبيت اللوحة"><svg class="ic" viewBox="0 0 24 24"><path d="M12 17v5"/><path d="M8 4h8"/><path d="M9 4v5c0 1.6-2.2 2.6-2.2 4.2h10.4C16.2 11.6 14 10.6 14 9V4"/></svg></button>
    <button class="ctrl" id="btnSettings" data-i18n-title="settings" data-i18n-aria="settings" aria-label="الإعدادات"><svg class="ic" viewBox="0 0 24 24"><path d="M5 4v6m0 4v6M12 4v1m0 4v11M19 4v10m0 4v2"/><circle cx="5" cy="12" r="2"/><circle cx="12" cy="7" r="2"/><circle cx="19" cy="16" r="2"/></svg></button>
    <button class="ctrl" id="btnDl" aria-label="download"><svg class="ic" viewBox="0 0 24 24"><path d="M12 3v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4 19h16"/></svg></button>
    <button class="ctrl" id="btnExpand" aria-label="expand"><svg class="ic ic-exp" viewBox="0 0 24 24"><path d="M4 9V4h5"/><path d="M20 15v5h-5"/><path d="M4 4l6 6"/><path d="M20 20l-6-6"/></svg><svg class="ic ic-set" viewBox="0 0 24 24"><path d="M4 6h9M17 6h3"/><circle cx="15" cy="6" r="2"/><path d="M4 12h3M11 12h9"/><circle cx="9" cy="12" r="2"/><path d="M4 18h9M17 18h3"/><circle cx="15" cy="18" r="2"/></svg></button>
  </div>
</footer>
