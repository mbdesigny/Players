<!-- ══════════ PLAYER BAR ══════════ -->
<footer class="player">
  <div class="pb-track">
    <button class="pb-art" id="pbArt" aria-label="now playing"><img id="pbArtImg" alt=""><span class="ov-ic"><svg class="ic" viewBox="0 0 24 24"><path d="M4 9V4h5"/><path d="M20 15v5h-5"/><path d="M4 4l6 6"/><path d="M20 20l-6-6"/></svg></span></button>
    <div class="pb-info"><div class="pb-title" id="pbTitle">أُنس</div><div class="pb-sub" id="pbSub" data-i18n="tagline">رفيقك لتلاوة القرآن الكريم</div></div>
    <button class="ctrl pb-fav" id="pbFav" aria-label="favorite"><svg class="ic" viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.3-9A5.2 5.2 0 0 1 12 6.6a5.2 5.2 0 0 1 9.3 4.9c-1.8 4.4-9.3 9-9.3 9z"/></svg></button>
  </div>
  <div class="pb-center">
    <div class="pb-buttons">
      <button class="ctrl" id="btnShuffle" aria-label="shuffle"><svg class="ic" viewBox="0 0 24 24"><path d="M16 4h4v4"/><path d="M4 20 20 4"/><path d="M16 20h4v-4"/><path d="m14.5 14.5 5.5 5.5"/><path d="m4 4 5 5"/></svg></button>
      <button class="ctrl" id="btnPrev" aria-label="previous"><svg class="ic fill" viewBox="0 0 24 24"><path d="M18 5v14l-9-7z"/><rect x="5" y="5" width="2.6" height="14" rx="1"/></svg></button>
      <button class="play-btn" id="btnPlay" aria-label="play"><svg class="ic play-ic" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z"/></svg></button>
      <button class="ctrl" id="btnNext" aria-label="next"><svg class="ic fill" viewBox="0 0 24 24"><path d="M6 5v14l9-7z"/><rect x="16.4" y="5" width="2.6" height="14" rx="1"/></svg></button>
      <button class="ctrl" id="btnRepeat" aria-label="repeat"><svg class="ic" viewBox="0 0 24 24"><path d="M17 2.5 21 6l-4 3.5"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="M7 21.5 3 18l4-3.5"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></svg><span class="rep-1" id="repBadge" hidden>1</span></button>
    </div>
    <div class="pb-progress" dir="ltr">
      <span class="t" id="tCur">0:00</span>
      <div class="prog" id="progBar"><div class="rail"><div class="buf" id="progBuf"></div><div class="fill" id="progFill"></div><div class="thumb" id="progThumb"></div></div></div>
      <span class="t" id="tDur">0:00</span>
    </div>
  </div>
  <div class="pb-right">
    <button class="ctrl" id="npToggle" aria-label="now playing panel"><svg class="ic" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg></button>
    <select id="selQuality" aria-label="quality"></select>
    <select id="selSpeed" aria-label="speed"><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select>
    <div class="sleep-wrap">
      <button class="ctrl" id="btnSleep" aria-label="sleep timer"><svg class="ic" viewBox="0 0 24 24"><path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5z"/></svg><span class="sleep-badge" id="sleepBadge" hidden></span></button>
      <div class="popover" id="sleepPop"></div>
    </div>
    <div class="vol">
      <button class="ctrl" id="btnMute" aria-label="mute"><svg class="ic" id="volIcon" viewBox="0 0 24 24"><path d="M11 5 6.5 9H3v6h3.5L11 19z"/><path d="M15 9a4 4 0 0 1 0 6"/><path d="M17.5 6.5a8 8 0 0 1 0 11"/></svg></button>
      <div class="prog" id="volBar" dir="ltr"><div class="rail"><div class="fill" id="volFill"></div><div class="thumb" id="volThumb"></div></div></div>
    </div>
    <button class="ctrl" id="btnDl" aria-label="download"><svg class="ic" viewBox="0 0 24 24"><path d="M12 3v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4 19h16"/></svg></button>
    <button class="ctrl" id="btnExpand" aria-label="expand"><svg class="ic" viewBox="0 0 24 24"><path d="M4 9V4h5"/><path d="M20 15v5h-5"/><path d="M4 4l6 6"/><path d="M20 20l-6-6"/></svg></button>
  </div>
</footer>
