---
import AudioReactiveBg from './AudioReactiveBg.astro';
---

<!-- ══════════ FULLSCREEN NOW PLAYING ══════════ -->
<div class="np-overlay" id="npOverlay">
  <div class="ov-bg"><div class="ov-aurora"><i></i><i></i><i></i></div><div class="glow" style="width:60vw;height:60vw;top:-20vw;inset-inline-start:-15vw;background:var(--glow1)"></div><div class="glow" style="width:50vw;height:50vw;bottom:-18vw;inset-inline-end:-12vw;background:var(--glow2)"></div><div class="lattice" style="position:absolute;inset:0;opacity:var(--lattice)"></div></div>
  <div class="ov-photo" id="ovPhoto"></div>
  <AudioReactiveBg />
  <canvas class="ov-waves" id="ovWaves" aria-hidden="true"></canvas>
  <div class="ov-top">
    <span class="lbl" data-i18n="nowPlaying">يُتلى الآن</span>
    <button class="icon-btn" id="ovClose" aria-label="close"><svg class="ic" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
  </div>
  <div class="ov-mandala"><div class="mandala-glow"></div><div class="mandala-wrap" id="ovMandala"></div></div>
  <div class="ov-title amiri" id="ovTitle">أُنس</div>
  <div class="ov-artist" id="ovArtist"></div>
  <div class="ov-badges" id="ovBadges"></div>
  <div class="ov-progress pb-progress" dir="ltr">
    <span class="t" id="ovCur">0:00</span>
    <div class="prog" id="ovProg" role="slider" tabindex="0" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" data-i18n-aria="kSeek" aria-label="تقدّم / إيقاع ٥ ثوانٍ"><div class="rail"><div class="buf" id="ovBuf"></div><div class="fill" id="ovFill"></div><div class="thumb" id="ovThumb"></div></div></div>
    <span class="t" id="ovDur">0:00</span>
  </div>
  <div class="ov-controls">
    <button class="ctrl" data-act="shuffle" data-i18n-aria="shuffle" aria-label="عشوائي"><svg class="ic" viewBox="0 0 24 24"><path d="M16 4h4v4"/><path d="M4 20 20 4"/><path d="M16 20h4v-4"/><path d="m14.5 14.5 5.5 5.5"/><path d="m4 4 5 5"/></svg></button>
    <button class="ctrl" data-act="prev" data-i18n-aria="previous" aria-label="السابق"><svg class="ic fill" viewBox="0 0 24 24"><path d="M18 5v14l-9-7z"/><rect x="5" y="5" width="2.6" height="14" rx="1"/></svg></button>
    <button class="play-btn" data-act="play" data-i18n-aria="play" aria-label="تشغيل"><svg class="ic play-ic" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z"/></svg></button>
    <button class="ctrl" data-act="next" data-i18n-aria="next" aria-label="التالي"><svg class="ic fill" viewBox="0 0 24 24"><path d="M6 5v14l9-7z"/><rect x="16.4" y="5" width="2.6" height="14" rx="1"/></svg></button>
    <button class="ctrl" data-act="repeat" data-i18n-aria="repeat" aria-label="تكرار"><svg class="ic" viewBox="0 0 24 24"><path d="M17 2.5 21 6l-4 3.5"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="M7 21.5 3 18l4-3.5"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/></svg></button>
  </div>
  <div class="ov-actions">
    <button class="btn sm" data-act="fav"><svg class="ic" viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-9.3-9A5.2 5.2 0 0 1 12 6.6a5.2 5.2 0 0 1 9.3 4.9c-1.8 4.4-9.3 9-9.3 9z"/></svg><span data-i18n="favorite">المفضلة</span></button>
    <button class="btn sm" data-act="download"><svg class="ic" viewBox="0 0 24 24"><path d="M12 3v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4 19h16"/></svg><span data-i18n="download">تنزيل</span></button>
  </div>
</div>
