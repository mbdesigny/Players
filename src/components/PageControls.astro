---
// ═══ عناصر تحكم ثابتة تعيش في شريط الأدوات العلوي لكل الصفحات الثابتة ═══
// الأزرار: الإعدادات (يفتح #settingsScrim) + اللغة (AR/EN) + الثيم (فاتح/داكن)
const { version } = Astro.props;
---

<div class="top-actions">
  <button class="icon-btn" id="settingsBtn" data-i18n-aria="settings" aria-label="الإعدادات" aria-expanded="false"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.14-1.4l2-1.55-2-3.46-2.35.95a7 7 0 0 0-2.42-1.4L13.7 2.6h-3.4l-.39 2.54a7 7 0 0 0-2.42 1.4l-2.35-.95-2 3.46 2 1.55A7 7 0 0 0 5 12c0 .48.05.94.14 1.4l-2 1.55 2 3.46 2.35-.95a7 7 0 0 0 2.42 1.4l.39 2.54h3.4l.39-2.54a7 7 0 0 0 2.42-1.4l2.35.95 2-3.46-2-1.55c.09-.46.14-.92.14-1.4z"/></svg></button>
  <button class="icon-btn txt" id="langBtn" data-i18n-aria="language" aria-label="اللغة">EN</button>
  <button class="icon-btn" id="themeBtn" data-i18n-aria="theme" aria-label="المظهر">
    <svg class="ic theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5z"/></svg>
    <svg class="ic theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M19.4 4.6l-1.8 1.8M6.4 17.6l-1.8 1.8"/></svg>
  </button>
</div>

<!-- ═══ مودال الإعدادات — نفس #settingsScrim الخاص بالتطبيق، بنفس مكوّناته العالمية (scrim/modal/set-row/seg) ═══ -->
<div class="scrim" id="settingsScrim">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
    <h3 id="settingsTitle"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></svg><span data-i18n="settings">الإعدادات</span></h3>
    <div class="set-row"><div><div class="sl" data-i18n="theme">المظهر</div><div class="sd" data-i18n="themeDesc">نهاري بيج / ليلي OLED</div></div>
      <div class="seg" id="segTheme" role="group" data-i18n-aria="theme" aria-label="المظهر"><button data-th="light" data-i18n="light" aria-pressed="false">نهاري</button><button data-th="dark" data-i18n="dark" aria-pressed="false">ليلي</button></div></div>
    <div class="set-row"><div><div class="sl" data-i18n="language">اللغة</div><div class="sd">العربية / English</div></div>
      <div class="seg" id="segLang" role="group" data-i18n-aria="language" aria-label="اللغة"><button data-lg="ar" aria-pressed="false">العربية</button><button data-lg="en" aria-pressed="false">English</button></div></div>
    <div class="set-ver" dir="ltr">أُنْس · v{version}</div>
    <div class="m-actions"><button class="btn primary" id="settingsClose" data-i18n="done">تم</button></div>
  </div>
</div>

<style>
  /* ═══ سطر الإصدار فقط (البقية كلها أنماط عالمية من التطبيق) ═══ */
  .set-ver {
    font-size: var(--fs-2xs);
    color: var(--ink2);
    text-align: center;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    font-style: normal
  }

  /* ═══ أيقونة الثيم: هلال بالنهاري، شمس بالليلي (فقاعة scope فقط — العنصر ثابت وقت البناء) ═══ */
  .theme-sun {
    display: none
  }

  :global([data-theme="dark"]) .theme-moon {
    display: none
  }

  :global([data-theme="dark"]) .theme-sun {
    display: block
  }
</style>
