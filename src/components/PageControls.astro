---
// ═══ عناصر تحكم ثابتة تعيش في شريط الأدوات العلوي لكل الصفحات الثابتة ═══
// نفس ترتيب ومكوّنات Center.astro: الثيم ← اللغة ← الإعدادات
// مودال الإعدادات هو مكوّن Modals.astro الموجود مسبقًا (لا إعادة كتابة ولا عناصر جديدة)
import Modals from './Modals.astro';
---

<div class="top-actions">
  <button class="icon-btn" id="themeBtn" data-i18n-aria="theme" aria-label="المظهر"><svg class="ic" id="themeIcon" viewBox="0 0 24 24"><path d="M20 13.5A8 8 0 0 1 10.5 4 8 8 0 1 0 20 13.5z"/></svg></button>
  <button class="icon-btn txt" id="langBtn" data-i18n-aria="language" aria-label="اللغة">EN</button>
  <button class="icon-btn" id="settingsBtn" data-i18n-aria="settings" aria-label="الإعدادات" aria-expanded="false"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 0 0-.14-1.4l2-1.55-2-3.46-2.35.95a7 7 0 0 0-2.42-1.4L13.7 2.6h-3.4l-.39 2.54a7 7 0 0 0-2.42 1.4l-2.35-.95-2 3.46 2 1.55A7 7 0 0 0 5 12c0 .48.05.94.14 1.4l-2 1.55 2 3.46 2.35-.95a7 7 0 0 0 2.42 1.4l.39 2.54h3.4l.39-2.54a7 7 0 0 0 2.42-1.4l2.35.95 2-3.46-2-1.55c.09-.46.14-.92.14-1.4z"/></svg></button>
</div>

<!-- ═══ مودالات التطبيق الأصلية كما هي (#settingsScrim ضمنها) ═══ -->
<Modals />
