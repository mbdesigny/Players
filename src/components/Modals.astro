<!-- ══════════ SETTINGS ══════════ -->
<div class="scrim" id="settingsScrim">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="settingsTitle">
    <h3 id="settingsTitle"><svg class="ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></svg><span data-i18n="settings">الإعدادات</span></h3>
    <div class="set-row"><div><div class="sl" data-i18n="theme">المظهر</div><div class="sd" data-i18n="themeDesc">نهاري بيج / ليلي OLED</div></div>
      <div class="seg" id="segTheme" role="group" data-i18n-aria="theme" aria-label="المظهر"><button data-th="light" data-i18n="light" aria-pressed="false">نهاري</button><button data-th="dark" data-i18n="dark" aria-pressed="false">ليلي</button></div></div>
    <div class="set-row"><div><div class="sl" data-i18n="language">اللغة</div><div class="sd">العربية / English</div></div>
      <div class="seg" id="segLang" role="group" data-i18n-aria="language" aria-label="اللغة"><button data-lg="ar" aria-pressed="false">العربية</button><button data-lg="en" aria-pressed="false">English</button></div></div>
    <div class="set-row"><div><div class="sl" data-i18n="mushafRiwaya">رواية المصحف</div><div class="sd" data-i18n="mushafRiwayaDesc">المصحف المكتوب — حفص عن عاصم / ورش عن نافع</div></div>
      <div class="seg" id="segMushafRw" role="group" data-i18n-aria="mushafRiwaya" aria-label="رواية المصحف"><button data-mrw="hafs" data-i18n="rwHafs" aria-pressed="false">حفص</button><button data-mrw="warsh" data-i18n="rwWarsh" aria-pressed="false">ورش</button></div></div>
    <div class="set-row"><div><div class="sl" data-i18n="adhan">الأذان</div><div class="sd" data-i18n="adhanDesc">تشغيل الأذان تلقائياً عند دخول وقت الصلاة</div></div>
      <div class="seg" id="segAdhan" role="group" data-i18n-aria="adhan" aria-label="الأذان"><button data-adh="on" data-i18n="adhanOn" aria-pressed="false">مفعّل</button><button data-adh="off" data-i18n="adhanOff" aria-pressed="false">معطّل</button></div></div>
    <div class="set-row"><div><div class="sl" data-i18n="audioSource">مصدر الصوت</div><div class="sd" data-i18n="audioSourceDesc">يُختار الأعلى جودة تلقائيًا مع تجاوز عند الفشل</div></div>
      <span class="tag gold">MP3Quran + Islamic Network</span></div>
    <div class="keys">
      <div class="queue-head" data-i18n="shortcuts">اختصارات لوحة المفاتيح</div>
      <div class="krow"><span data-i18n="kPlay">تشغيل / إيقاف</span><kbd>Space</kbd></div>
      <div class="krow"><span data-i18n="kSeek">تقديم / ترجيع ٥ ثوانٍ</span><kbd>→ ←</kbd></div>
      <div class="krow"><span data-i18n="kNext">التالي / السابق</span><kbd>N / P</kbd></div>
      <div class="krow"><span data-i18n="kFav">المفضلة</span><kbd>F</kbd></div>
      <div class="krow"><span data-i18n="kMute">كتم الصوت</span><kbd>M</kbd></div>
      <div class="krow"><span data-i18n="kSearch">بحث</span><kbd>/</kbd></div>
    </div>
    <div class="m-actions"><button class="btn primary" id="settingsClose" data-i18n="done">تم</button></div>
  </div>
</div>

<!-- ══════════ PRAYER SETTINGS ══════════ -->
<div class="scrim" id="prayerScrim">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="prayerTitle" style="width:min(560px,92vw)">
    <h3 id="prayerTitle"><svg class="ic" viewBox="0 0 24 24"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg><span data-i18n="prayerTimes">مواقيت الصلاة</span></h3>
    <div id="prayerSetBody"></div>
    <div class="m-actions"><button class="btn primary" id="prayerSetClose" data-i18n="done">تم</button></div>
  </div>
</div>

<!-- ═══════════════ QUALITY ═══════════════ -->
<div class="scrim" id="qualityScrim">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="qualityTitle" style="width:min(400px,92vw)">
    <h3 id="qualityTitle"><svg class="ic" viewBox="0 0 24 24"><path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1 1.55V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1-1.55 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.55-1H3a2 2 0 1 1 0-4h.09a1.7 1.7 0 0 0 1.55-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.7 1.7 0 0 0 1.87.34h0a1.7 1.7 0 0 0 1-1.55V3a2 2 0 1 1 4 0v.09a1.7 1.7 0 0 0 1 1.55h0a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.7 1.7 0 0 0-.34 1.87v0a1.7 1.7 0 0 0 1.55 1H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.55 1z"/></svg><span data-i18n="quality">الجودة</span></h3>
    <div class="seg" id="segQuality" role="group" data-i18n-aria="quality" aria-label="الجودة">
      <button data-q="auto" data-i18n="qAuto" aria-pressed="false">أعلى جودة</button>
      <button data-q="high" data-i18n="qHigh" aria-pressed="false">١٩٢+</button>
      <button data-q="std" data-i18n="qStd" aria-pressed="false">١٢٨</button>
      <button data-q="save" data-i18n="qSave" aria-pressed="false">توفير البيانات</button>
    </div>
    <div class="m-actions"><button class="btn primary" id="qualityClose" data-i18n="done">تم</button></div>
  </div>
</div>

<!-- ══════════ CONFIRM ══════════ -->
<div class="scrim" id="confirmScrim">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" aria-describedby="confirmMsg" style="width:min(400px,92vw)">
    <h3 id="confirmTitle"></h3>
    <p style="color:var(--ink2);font-size:13.5px" id="confirmMsg"></p>
    <div class="m-actions"><button class="btn" id="confirmNo" data-i18n="cancel">إلغاء</button><button class="btn primary" id="confirmYes" data-i18n="confirm">تأكيد</button></div>
  </div>
</div>

<!-- ══════════ ADD TO QUEUE ══════════ -->
<div class="scrim" id="queueAddScrim">
  <div class="modal queue-add-modal" role="dialog" aria-modal="true" aria-labelledby="queueAddTitle" style="width:min(520px,94vw)">
    <div class="qa-head">
      <h3 id="queueAddTitle">
        <svg class="ic" viewBox="0 0 24 24"><path d="M4 6h16M4 12h12M4 18h8"/><path d="M18 12v8"/><path d="m15 17 3 3 3-3"/></svg>
        <span data-i18n="addToQueue">إضافة إلى قائمة التشغيل</span>
      </h3>
      <button class="mini-btn" id="queueAddClose" data-i18n-aria="close" aria-label="إغلاق"><svg class="ic" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
    </div>
    <div class="qa-body">
      <div class="qa-field">
        <label for="qaReciterSel" class="qa-label">
          <span class="qa-step">١</span>
          <span data-i18n="selectReciter">اختر القارئ</span>
        </label>
        <div class="qa-select-wrap">
          <select id="qaReciterSel" class="qa-select"></select>
        </div>
      </div>
      <div class="qa-field" id="qaMoshafField">
        <label for="qaMoshafSel" class="qa-label">
          <span class="qa-step">٢</span>
          <span data-i18n="selectRewaya">المصحف / الرواية</span>
        </label>
        <div class="qa-select-wrap">
          <select id="qaMoshafSel" class="qa-select"></select>
        </div>
      </div>
      <div class="qa-field">
        <div class="qa-surah-bar">
          <label class="qa-label">
            <span class="qa-step">٣</span>
            <span data-i18n="selectSurah">اختر السورة</span>
          </label>
          <input type="search" id="qaSurahSearch" class="qa-search-input" placeholder="ابحث عن سورة بالاسم أو الرقم…" data-i18n-ph="searchSurahPh">
        </div>
        <div class="qa-surah-grid" id="qaSurahList" role="listbox"></div>
      </div>
    </div>
    <div class="m-actions qa-foot">
      <button class="btn" id="queueAddCancel" data-i18n="cancel">إلغاء</button>
      <button class="btn primary" id="queueAddConfirm" disabled>
        <svg class="ic" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
        <span data-i18n="addSurah">إضافة سورة</span>
      </button>
    </div>
  </div>
</div>

<!-- ══════════ DOWNLOADS DRAWER ══════════ -->
<div class="drawer" id="dlDrawer" role="region" aria-label="Downloads" data-i18n-aria="downloads">
  <div class="d-head">
    <svg class="ic" viewBox="0 0 24 24" style="color:var(--gold-ink)"><path d="M12 3v11"/><path d="m7.5 10.5 4.5 4.5 4.5-4.5"/><path d="M4 19h16"/></svg>
    <b data-i18n="downloads">التنزيلات</b>
    <button class="btn sm" id="folderBtn" data-i18n="chooseFolder" hidden>مجلد الحفظ</button>
    <button class="mini-btn" id="dlClose" data-i18n-aria="close" aria-label="إغلاق"><svg class="ic" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
  </div>
  <div class="d-list" id="dlList"><div class="empty" style="padding:26px"><p data-i18n="noDownloads">لا توجد تنزيلات بعد</p></div></div>
</div>

<!-- ═══════════════ PHONE PLAYBACK CONTROLS ═══════════════ -->
<div class="scrim" id="phoneCtlScrim">
  <div class="modal phone-ctl" role="dialog" aria-modal="true" aria-labelledby="phoneCtlTitle">
    <h3 id="phoneCtlTitle"><svg class="ic" viewBox="0 0 24 24"><path d="M4 7h9"/><circle cx="16.5" cy="7" r="2.5"/><path d="M20 17h-9"/><circle cx="7.5" cy="17" r="2.5"/></svg><span data-i18n="playback">التحكم بالتشغيل</span></h3>
    <div class="set-row"><div class="sl" data-i18n="volume">الصوت</div>
      <div class="vol"><button class="ctrl" id="mMute" aria-label="mute"><svg class="ic" id="mVolIcon" viewBox="0 0 24 24"><path d="M11 5 6.5 9H3v6h3.5L11 19z"/><path d="M15 9a4 4 0 0 1 0 6"/><path d="M17.5 6.5a8 8 0 0 1 0 11"/></svg></button>
        <div class="prog" id="mVolBar" dir="ltr" role="slider" tabindex="0" aria-orientation="horizontal" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" data-i18n-aria="volume" aria-label="مستوى الصوت"><div class="rail"><div class="fill" id="mVolFill"></div><div class="thumb" id="mVolThumb"></div></div></div>
      </div></div>
    <div class="set-row"><div class="sl" data-i18n="speed">السرعة</div><b id="mSpeedVal" dir="ltr">1×</b></div>
    <input type="range" id="mSpeedRange" min="0.75" max="2" step="0.05" value="1" dir="ltr" data-i18n-aria="speed" aria-label="السرعة">
    <div class="mctl-sleep"><div class="sl" data-i18n="sleep">مؤقت النوم</div><div class="seg" id="mSleepSeg" role="group" data-i18n-aria="sleep" aria-label="مؤقت النوم"></div></div>
    <div class="m-actions"><button class="btn primary" id="phoneCtlClose" data-i18n="done">تم</button></div>
  </div>
</div>
