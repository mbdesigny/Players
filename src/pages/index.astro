---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Center from '../components/Center.astro';
import NowPlayingPanel from '../components/NowPlayingPanel.astro';
import PlayerBar from '../components/PlayerBar.astro';
import FullscreenPlayer from '../components/FullscreenPlayer.astro';
import Modals from '../components/Modals.astro';
import frame from '../assets/player-frame.svg?raw';
---
<Base>
  <div id="bgFx"><div class="glow g1"></div><div class="glow g2"></div><div class="lattice"></div><div class="grain"></div></div>

  <div class="shell">
    <Sidebar />
    <Center />
    <NowPlayingPanel />
  </div>

  <PlayerBar />
  <div class="npc" id="npcCard" role="group" data-i18n-aria="nowPlaying" aria-label="يُتلى الآن">
    <img id="npcArt" alt="" loading="lazy">
    <div class="npc-meta" id="npcMeta">
      <b id="npcTitle">أُنس</b>
      <span id="npcArtist"></span>
    </div>
    <button class="mini-btn" id="npcPlay" data-i18n-aria="play" aria-label="تشغيل"><svg class="ic play-ic" viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z"/></svg></button>
    <button class="mini-btn" id="npcNext" data-i18n-aria="next" aria-label="التالي"><svg class="ic fill" viewBox="0 0 24 24"><path d="M6 5v14l9-7z"/><rect x="16.4" y="5" width="2.6" height="14" rx="1"/></svg></button>
    <button class="mini-btn" id="npcExpand" data-i18n-aria="expand" aria-label="ملء الشاشة"><svg class="ic" viewBox="0 0 24 24"><path d="M4 9V4h5"/><path d="M20 15v5h-5"/><path d="M4 4l6 6"/><path d="M20 20l-6-6"/></svg></button>
    <div class="npc-prog"><i id="npcFill"></i></div>
  </div>
  <FullscreenPlayer />
  <Modals />

  <div id="adhanBanner" role="alert">
    <div class="ab-inner">
      <svg class="ic" viewBox="0 0 24 24"><path d="M12 3c2 2 4 3.6 4 6H8c0-2.4 2-4 4-6z"/><path d="M5 21v-8a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v8"/><path d="M3 21h18"/><path d="M10 21v-4h4v4"/></svg>
      <div class="ab-txt" id="abText"></div>
      <button class="ab-stop" id="adhanStop" data-i18n="stopAdhan">إيقاف الأذان</button>
    </div>
  </div>
  <div id="toasts"></div>
  <audio id="audio" preload="metadata"></audio>

  <script is:inline type="text/svg-template" id="playerFrame" set:html={frame} />
  <script>
    import '../scripts/app.js';
  </script>
</Base>
