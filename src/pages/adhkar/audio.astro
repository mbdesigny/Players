    <div id="scrimSide"></div>

    <div class="center">
      <header class="topbar">
        <button class="icon-btn" id="menuBtn" data-i18n-aria="menu" aria-label="القائمة" aria-expanded="false"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        <button class="icon-btn" id="sideBtn" data-i18n-aria="hidePanel" aria-label="إخفاء اللوحة" aria-pressed="false"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg></button>
        <PageControls version={pkg.version} />
      </header>
      <main>
        <div class="aud-grid">
          {groups.map((g) => (
            <article class="aud-card">
              <img class="aud-hero" src={g.img} alt={g.alt} loading="lazy">
              <div class="aud-body">
                <div class="aud-intro">
                  <h2>{g.title}</h2>
                  <span class="aud-en">{g.titleEn}</span>
                </div>
                <div class="aud-foot">
                {g.readers.map((r) => (
                  <button class="aud-reader-btn" type="button" data-src={r.src} data-title={r.title} data-reciter={r.reciter} aria-pressed="false">
                    <span class="aud-ava" aria-hidden="true">{r.initial}</span>
                    <span class="aud-reader">{r.reciter}</span>
                    <span class="aud-pp" aria-hidden="true">
                      <svg class="ic pp-play" viewBox="0 0 24 24"><path d="M7 5v14"/><path d="M19 12 7 19V5z"/></svg>
                      <svg class="ic pp-pause" viewBox="0 0 24 24"><path d="M7 5v14"/><path d="M17 5v14"/></svg>
                    </span>
                  </button>
                ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </main>
    </div>
  </div>

  <div class="aud-player" id="audPlayer" aria-live="polite">
    <div class="aud-bar"><i id="audFill"></i></div>
    <div class="aud-row">
      <button class="aud-toggle" id="audToggle" data-i18n-aria="playToggle" aria-label="تشغيل / إيقاف" disabled>
        <svg class="ic pp-play" viewBox="0 0 24 24"><path d="M7 5v14"/><path d="M19 12 7 19V5z"/></svg>
        <svg class="ic pp-pause" viewBox="0 0 24 24"><path d="M7 5v14"/><path d="M17 5v14"/></svg>
      </button>
      <div class="aud-meta">
        <b id="audTitle" data-i18n="pickPrompt">اختر أذكارًا للاستماع</b>
        <span id="audReader"></span>
      </div>
      <span class="aud-time" id="audTime">00:00</span>
    </div>
  </div>

  <audio id="adhkarAudio" preload="none"></audio>
</Base>

<style>
  .adk-shell {
    grid-template-columns: var(--sidebar) minmax(0, 1fr)
  }

  .adk-shell a.nav-item {
    text-decoration: none
  }

  @media (max-width: 900px) {
    .adk-shell {
      grid-template-columns: minmax(0, 1fr)
    }
  }

</style>

<script>
  import { initPageChrome } from '../../scripts/lib/page-chrome.js';

  // ═══ قاموس الترجمة المحلي للصفحة (المكتبة + عناصر التحكم + نصوص المشغّل) ═══
  const T = {
    ar: { library: 'المكتبة', home: 'الرئيسية', reciters: 'القرّاء', favorites: 'المفضلة', recent: 'سجل الاستماع', mushaf: 'المصحف', adhkar: 'الأذكار', prayerTimes: 'مواقيت الصلاة', ytView: 'أفضل التلاوات', developer: 'المُطوِّر', sideFoot: 'أُنْس · رفيق التلاوة', menu: 'القائمة', hidePanel: 'إخفاء اللوحة', settings: 'الإعدادات', theme: 'المظهر', themeDesc: 'نهاري بيج / ليلي OLED', light: 'نهاري', dark: 'ليلي', language: 'اللغة', adhan: 'الأذان', adhanDesc: 'تشغيل الأذان تلقائيًا عند دخول وقت الصلاة', adhanOn: 'مفعّل', adhanOff: 'معطّل', mushafRiwaya: 'رواية المصحف', mushafRiwayaDesc: 'المصحف المكتوب — حفص عن عاصم / ورش عن نافع', rwHafs: 'حفص عن عاصم', rwWarsh: 'ورش عن نافع', shortcuts: 'اختصارات لوحة المفاتيح', kPlay: 'تشغيل / إيقاف', kSeek: 'تقديم / ترجيع ٥ ثوانٍ', kNext: 'التالي / السابق', kFav: 'المفضلة', kMute: 'كتم الصوت', kSearch: 'بحث', close: 'إغلاق', done: 'تم', pickPrompt: 'اختر أذكارًا للاستماع', playToggle: 'تشغيل / إيقاف', playError: 'تعذَّر تشغيل الملف — تحقَّق من المسار' },
    en: { library: 'Library', home: 'Home', reciters: 'Reciters', favorites: 'Favorites', recent: 'Recently Played', mushaf: 'Mushaf', adhkar: 'Adhkar', prayerTimes: 'Prayer times', ytView: 'Best recitations', developer: 'Developer', sideFoot: 'Ouns · Recitation Companion', menu: 'Menu', hidePanel: 'Hide panel', settings: 'Settings', theme: 'Theme', themeDesc: 'Beige light / OLED dark', light: 'Light', dark: 'Dark', language: 'Language', adhan: 'Adhan', adhanDesc: 'Play the adhan automatically at prayer time', adhanOn: 'On', adhanOff: 'Off', mushafRiwaya: 'Mushaf riwayah', mushafRiwayaDesc: "Written mushaf — Hafs 'an 'Asim / Warsh 'an Nafi'", rwHafs: "Hafs 'an 'Asim", rwWarsh: "Warsh 'an Nafi'", shortcuts: 'Keyboard shortcuts', kPlay: 'Play / pause', kSeek: 'Seek ±5 seconds', kNext: 'Next / previous', kFav: 'Favorite', kMute: 'Mute', kSearch: 'Search', close: 'Close', done: 'Done', pickPrompt: 'Choose adhkar to listen', playToggle: 'Play / Pause', playError: "Couldn't play the file — check the path" },
  };

  const audio = document.getElementById('adhkarAudio');
  const player = document.getElementById('audPlayer');
  const toggle = document.getElementById('audToggle');
  const fill = document.getElementById('audFill');
  const title = document.getElementById('audTitle');
  const reader = document.getElementById('audReader');
  const time = document.getElementById('audTime');
  const buttons = [...document.querySelectorAll('.aud-reader-btn')];

  const fmt = (s) => {
    if (!Number.isFinite(s) || s < 0) s = 0;
    const m = Math.floor(s / 60), r = Math.floor(s % 60);
    return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
  };

  let active = null;

  // ═══ عناصر التحكم الثابتة (سايدبار + ثيم + لغة + إعدادات) من الوحدة المشتركة ═══
  const chrome = initPageChrome({
    i18n: T,
    onLang() {
      // إن كان هناك مقطع مُختار فلا تُعِد العنوان إلى نص البداية
      if (active) title.textContent = active.dataset.title;
    },
  });

  function pulse() {
    if (audio.paused) audio.play().catch(() => {});
    else audio.pause();
  }

  function select(btn) {
    active = btn;
    buttons.forEach((b) => {
      const on = b === btn;
      b.classList.toggle('playing', on);
      b.setAttribute('aria-pressed', String(on));
    });
    title.textContent = btn.dataset.title;
    reader.textContent = btn.dataset.reciter;
    toggle.disabled = false;
    player.classList.add('active');
    if (audio.src !== btn.dataset.src) audio.src = btn.dataset.src;
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (active === btn) pulse();
      else {
        select(btn);
        audio.play().catch(() => {});
      }
    });
  });

  toggle.addEventListener('click', () => {
    if (audio.src) pulse();
  });

  audio.addEventListener('play', () => player.classList.add('playing'));
  audio.addEventListener('pause', () => player.classList.remove('playing'));

  audio.addEventListener('ended', () => {
    player.classList.remove('playing');
    fill.style.width = '0%';
    time.textContent = '00:00';
  });

  audio.addEventListener('loadedmetadata', () => {
    time.textContent = fmt(audio.duration);
  });

  audio.addEventListener('timeupdate', () => {
    time.textContent = fmt(audio.currentTime);
    const d = audio.duration;
    fill.style.width = Number.isFinite(d) && d > 0 ? `${(audio.currentTime / d) * 100}%` : '0%';
  });

  audio.addEventListener('error', () => {
    if (!audio.src || !audio.error) return;
    title.textContent = T[chrome.lang()].playError;
    player.classList.remove('playing');
  });
</script>
