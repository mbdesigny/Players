---
import Base from '../../layouts/Base.astro';

const tracks = [
  {
    id: 'sabah',
    title: 'أذكار الصباح',
    titleEn: 'Morning Adhkar',
    reciter: 'علاء عقل',
    reciterEn: 'Alaa Akl',
    src: '/audio/sabah-alaa.mp3',
  },
  {
    id: 'massa',
    title: 'أذكار المساء',
    titleEn: 'Evening Adhkar',
    reciter: 'حمزة بو الديب',
    reciterEn: 'Hamza Boueldib',
    src: '/audio/massa-hamza.mp3',
  },
];
---

<Base>
  <main class="aud-page">
    <a class="aud-back" href="/">← العودة إلى أُنْس</a>

    <header class="aud-head">
      <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/><path d="M20 17v3"/></svg>
      <h1>الأذكار الصوتية</h1>
    </header>

    <div class="aud-grid">
      {tracks.map((tr) => (
        <button class="aud-card" data-src={tr.src} data-title={tr.title} data-reciter={tr.reciter}>
          <span class="aud-art" aria-hidden="true">
            <svg class="ic" viewBox="0 0 24 24"><path d="M9 18V6l10-2v12"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="16.5" cy="16" r="2.5"/></svg>
          </span>
          <span class="aud-info">
            <b>{tr.title}</b>
            <span class="aud-en">{tr.titleEn}</span>
            <span class="aud-reader">بصوت {tr.reciter}</span>
          </span>
          <span class="aud-go" aria-hidden="true">
            <svg class="ic" viewBox="0 0 24 24"><path d="M7 5v14"/><path d="M19 12 7 19V5z"/></svg>
          </span>
        </button>
      ))}
    </div>

    <div class="aud-player" id="audPlayer" aria-live="polite">
      <div class="aud-bar"><i id="audFill"></i></div>
      <div class="aud-row">
        <button class="aud-toggle" id="audToggle" aria-label="تشغيل / إيقاف" disabled>
          <svg class="ic pp-play" viewBox="0 0 24 24"><path d="M7 5v14"/><path d="M19 12 7 19V5z"/></svg>
          <svg class="ic pp-pause" viewBox="0 0 24 24"><path d="M7 5v14"/><path d="M17 5v14"/></svg>
        </button>
        <div class="aud-meta">
          <b id="audTitle">اختر أذكارًا للاستماع</b>
          <span id="audReader"></span>
        </div>
        <span class="aud-time" id="audTime">00:00</span>
      </div>
    </div>

    <audio id="adhkarAudio" preload="none"></audio>
  </main>
</Base>

<style>
  .aud-page {
    min-height: 100dvh;
    max-width: 560px;
    margin-inline: auto;
    padding: 28px 20px;
    padding-top: max(28px, env(safe-area-inset-top));
    padding-bottom: calc(120px + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 18px
  }

  .aud-back {
    align-self: flex-start;
    font-size: var(--fs-sm);
    color: var(--ink2);
    text-decoration: none
  }

  .aud-back:hover {
    color: var(--gold)
  }

  .aud-head {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--gold)
  }

  .aud-head .ic {
    width: 26px;
    height: 26px
  }

  .aud-head h1 {
    font-size: var(--fs-4xl)
  }

  .aud-grid {
    display: flex;
    flex-direction: column;
    gap: 12px
  }

  .aud-card {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px;
    border-radius: var(--r-md, 16px);
    background: var(--surface);
    border: 1px solid var(--line);
    text-align: start;
    cursor: pointer;
    transition: border-color .15s ease, box-shadow .15s ease, transform .1s ease
  }

  .aud-card:hover {
    border-color: var(--gold);
    box-shadow: 0 8px 24px rgba(0, 0, 0, .08)
  }

  .aud-card:active {
    transform: scale(.98)
  }

  .aud-card.playing {
    border-color: var(--gold);
    box-shadow: 0 8px 24px var(--glow1)
  }

  .aud-art {
    flex: none;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--surface2);
    border: 1px solid var(--line);
    color: var(--gold)
  }

  .aud-art .ic {
    width: 24px;
    height: 24px
  }

  .aud-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0
  }

  .aud-info b {
    font-size: var(--fs-md);
    color: var(--ink)
  }

  .aud-en {
    font-size: var(--fs-2xs);
    color: var(--ink2)
  }

  .aud-reader {
    font-size: var(--fs-sm);
    color: var(--gold-ink, var(--gold));
    margin-top: 2px
  }

  .aud-go {
    flex: none;
    margin-inline-start: auto;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--gold);
    color: #fff
  }

  .aud-go .ic {
    width: 18px;
    height: 18px;
    stroke-width: 2
  }

  .aud-player {
    position: fixed;
    inset-inline: 16px;
    bottom: max(14px, env(safe-area-inset-bottom));
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 14px 40px rgba(0, 0, 0, .16);
    overflow: hidden;
    opacity: .75;
    transition: opacity .2s ease
  }

  .aud-player.active {
    opacity: 1;
    border-color: var(--gold)
  }

  .aud-bar {
    height: 3px;
    background: var(--surface2)
  }

  .aud-bar i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--gold)
  }

  .aud-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px
  }

  .aud-toggle {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--gold);
    color: #fff;
    border: 0;
    cursor: pointer
  }

  .aud-toggle:disabled {
    opacity: .45;
    cursor: default
  }

  .aud-toggle .ic {
    width: 20px;
    height: 20px;
    stroke-width: 2
  }

  .pp-pause {
    display: none
  }

  .aud-player.playing .pp-pause {
    display: block
  }

  .aud-player.playing .pp-play {
    display: none
  }

  .aud-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0
  }

  .aud-meta b {
    font-size: var(--fs-sm);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis
  }

  .aud-meta span {
    font-size: var(--fs-2xs);
    color: var(--ink2)
  }

  .aud-time {
    margin-inline-start: auto;
    font-size: var(--fs-2xs);
    color: var(--ink2);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum'
  }
</style>

<script>
  const audio = document.getElementById('adhkarAudio');
  const player = document.getElementById('audPlayer');
  const toggle = document.getElementById('audToggle');
  const fill = document.getElementById('audFill');
  const title = document.getElementById('audTitle');
  const reader = document.getElementById('audReader');
  const time = document.getElementById('audTime');
  const cards = [...document.querySelectorAll('.aud-card')];

  const fmt = (s) => {
    if (!Number.isFinite(s) || s < 0) s = 0;
    const m = Math.floor(s / 60), r = Math.floor(s % 60);
    return `${String(m).padStart(2, '0')}:${String(r).padStart(2, '0')}`;
  };

  let active = null;

  function select(card) {
    active = card;
    cards.forEach((c) => c.classList.toggle('playing', c === card));
    title.textContent = card.dataset.title;
    reader.textContent = card.dataset.reciter;
    toggle.disabled = false;
    player.classList.add('active');
    if (audio.src !== card.dataset.src) audio.src = card.dataset.src;
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => {
      if (active === card) {
        if (audio.paused) audio.play().catch(() => {});
        else audio.pause();
        return;
      }
      select(card);
      audio.play().catch(() => {});
    });
  });

  toggle.addEventListener('click', () => {
    if (!audio.src) return;
    if (audio.paused) audio.play().catch(() => {});
    else audio.pause();
  });

  audio.addEventListener('play', () => player.classList.add('playing'));
  audio.addEventListener('pause', () => player.classList.remove('playing'));

  audio.addEventListener('ended', () => {
    player.classList.remove('playing');
    fill.style.width = '0%';
    time.textContent = '00:00';
  });

  audio.addEventListener('loadedmetadata', () => {
    time.textContent = fmt(audio.duration);
  });

  audio.addEventListener('timeupdate', () => {
    time.textContent = fmt(audio.currentTime);
    const d = audio.duration;
    fill.style.width = Number.isFinite(d) && d > 0 ? `${(audio.currentTime / d) * 100}%` : '0%';
  });

  audio.addEventListener('error', () => {
    if (!audio.src || !audio.error) return;
    title.textContent = 'تعذّر تشغيل الملف — تحقّق من المسار';
    reader.textContent = active ? active.dataset.reciter : '';
    player.classList.remove('playing');
  });
</script>
