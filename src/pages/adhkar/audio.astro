---
import Base from '../../layouts/Base.astro';
import PageControls from '../../components/PageControls.astro';
import data from '../../data/adhkar-audio.json';
import pkg from '../../../package.json';

const periods = ['morning', 'afternoon'];

const groups = periods.map((period) => {
  const first = data.tracks.find((tr) => tr.period === period);
  return {
    title: first.titleAr,
    titleEn: first.titleEn,
    img: data.images[period],
    alt: first.titleAr,
    readers: data.tracks
      .filter((tr) => tr.period === period)
      .map((tr) => ({
        initial: tr.reciterAr.trim().charAt(0),
        src: tr.src,
        title: tr.titleAr,
        reciter: tr.reciterAr,
      })),
  };
});
