<style>
  /* ═══ إطار الصفحة: نفس بنية shell بعمودين فقط (بدون لوحة التشغيل) ═══ */
  .dev-shell {
    grid-template-columns: var(--sidebar) minmax(0, 1fr)
  }

  .dev-shell a.nav-item {
    text-decoration: none
  }

  @media (max-width: 900px) {
    .dev-shell {
      grid-template-columns: minmax(0, 1fr)
    }
  }

  /* ═══ منطقة العمل: البطاقة في المنتصف ومتوازنة مع كل المقاسات ═══ */
  .dev-main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--gutter-y) var(--gutter) calc(var(--gutter) + 10px)
  }

  .dev-card {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 560px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, .10);
    padding: 34px 28px;
    text-align: center
  }

  /* شريط متدرّج أعلى البطاقة — نفس هوية الملف السابق */
  .dev-card::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 4px;
