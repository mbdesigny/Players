---
import Base from '../layouts/Base.astro';
import pkg from '../../package.json';

const web = 'https://graphixy-v2.pages.dev/';
const github = 'https://github.com/mbdesigny';
const email = 'mostafaben43@gmail.com';
const version = pkg.version;

const bugSubject = encodeURIComponent(`أُنْس v${version} — Layout / Bug report`);
const mailto = `mailto:${email}?subject=${bugSubject}&body=${encodeURIComponent('الصفحة: \nالوصف: \n')}`;
---

<Base>
  <main class="dev-page">
    <section class="dev-card" aria-labelledby="devTitle">
      <img class="dev-logo" src="/graphixy-logo.svg" alt="Graphixy Agency — وكالة جرافكسي" width="192" height="48">

      <h1 id="devTitle">وكالة جرافكسي <span class="dev-en">Graphixy Agency</span></h1>

      <p class="dev-bio" dir="rtl">
        وكالة تصميم وتطوير واجهات رقمية — نصمّم ونبني تطبيقات ويب سريعة، أنيقة، وتهتم بأدق تفاصيل
        تجربة المستخدم. هذا المشغّل (أُنْس) من تطويرنا: PWA عربي بالكامل، يعمل دون اتصال،
        ومهيأ لأداء سلس على الأجهزة الاقتصادية.
      </p>
      <p class="dev-bio dev-bio-en" dir="ltr">
        A digital design &amp; engineering agency — we craft fast, elegant web apps obsessed with
        UX detail. Ouns, this Qur'an player, is our build: a fully Arabic PWA that works offline
        and stays smooth on budget devices.
      </p>

      <nav class="dev-links" aria-label="Contact">
        <a class="dev-link" href={`mailto:${email}`}>
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <span dir="ltr">Email</span>
        </a>
        <a class="dev-link" href={web} target="_blank" rel="noopener">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>
          <span dir="ltr">Website</span>
        </a>
        <a class="dev-link" href={github} target="_blank" rel="noopener">
          <svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          <span dir="ltr">GitHub</span>
        </a>
      </nav>

      <a class="dev-bug" href={mailto}>
        <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 20h20L12 3z"/><path d="M12 10v5M12 17.6v.4"/></svg>
        <span>الإبلاغ عن مشكلة <span class="dev-en" dir="ltr">· Report a bug</span></span>
      </a>

      <span class="dev-ver" dir="ltr" title={`Ouns v${version}`}>أُنْس · v{version}</span>
    </section>

    <a class="dev-back" href="/">← العودة إلى أُنْس</a>
  </main>
</Base>

<style>
  .dev-page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 28px 20px;
    padding-top: max(28px, env(safe-area-inset-top));
  }

  .dev-card {
    width: 100%;
    max-width: 540px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 22px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, .10);
    padding: 34px 28px;
    text-align: center;
  }

  .dev-logo {
    width: 192px;
    height: auto;
    margin-bottom: 18px;
  }

  .dev-card h1 {
    font-size: var(--fs-xl);
    color: var(--ink);
    margin: 0 0 14px;
  }

  .dev-en {
    font-size: var(--fs-sm);
    color: var(--ink2);
    font-weight: 500;
  }

  h1 .dev-en {
    display: block;
    margin-top: 2px
  }

  .dev-bio {
    font-size: var(--fs-sm);
    line-height: 1.9;
    color: var(--ink2);
    margin: 0 0 10px;
  }

  .dev-bio-en {
    font-size: var(--fs-2xs);
    line-height: 1.7
  }

  .dev-links {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 18px 0 20px;
  }

  .dev-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line2);
    background: var(--surface2);
    color: var(--ink);
    font-size: var(--fs-xs);
    text-decoration: none;
    transition: border-color .15s ease, color .15s ease, transform .1s ease, opacity .1s ease;
  }

  .dev-link .ic {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dev-link:hover {
    border-color: var(--gold);
    color: var(--gold);
  }

  .dev-link:active {
    transform: scale(.98);
    opacity: .9;
  }

  .dev-bug {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 22px;
    border-radius: 999px;
    background: var(--gold);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(0, 0, 0, .12);
    transition: transform .1s ease, opacity .1s ease, box-shadow .15s ease;
  }

  .dev-bug .ic {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dev-bug:hover {
    box-shadow: 0 10px 26px rgba(0, 0, 0, .16);
  }

  .dev-bug:active {
    transform: scale(.98);
    opacity: .92;
  }

  .dev-ver {
    display: inline-block;
    margin-top: 20px;
    padding: 5px 14px;
    border-radius: 999px;
    border: 1px solid var(--gold);
    color: var(--gold);
    font-size: var(--fs-2xs);
    font-variant-numeric: tabular-nums;
  }

  .dev-back {
    color: var(--ink2);
    font-size: var(--fs-xs);
    text-decoration: none;
    transition: color .15s ease;
  }

  .dev-back:hover {
    color: var(--gold);
  }
</style>
