{
  "name": "ouns",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-hashes.mjs && node scripts/bump-sw.mjs",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint src/scripts/lib tests",
    "format": "prettier --write src/scripts/lib tests"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.11",
    "page-flip": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^17.14.0",
    "prettier": "^3.7.4",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
